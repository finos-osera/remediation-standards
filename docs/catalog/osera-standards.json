      ],
      "requirements": [
        {
          "id": "FORK-002.REQ-001",
          "level": "MUST",
          "text": "Patch providers must create version-scoped backpatch branches using backpatch/<version>.",
          "checkability": "automated",
          "checks": [
            {
              "id": "FORK-002.CHECK-001",
              "title": "Supported line has a backpatch version branch",
              "type": "repository",
              "severity": "blocking",
