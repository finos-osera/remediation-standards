{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.osera.finos.org/schemas/osera-standard-pack-0.1.0.schema.json",
  "title": "OSERA Standard Pack",
  "schema-version": "0.1.0",
  "type": "object",
  "required": [
    "schema-version",
    "id",
    "title",
    "status",
    "proposed_date",
    "target_decision_date",
    "target_gate_date",
    "ratified_date",
    "included_standards"
  ],
  "properties": {
    "schema-version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^OSERA-SP-[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "proposed_date": {
      "type": "string"
    },
    "target_decision_date": {
      "type": "string"
    },
    "target_gate_date": {
      "type": "string"
    },
    "ratified_date": {
      "type": "string"
    },
    "included_standards": {
      "$ref": "#/$defs/packStandards"
    },
    "advisory_standards": {
      "$ref": "#/$defs/packStandards"
    },
    "observe_standards": {
      "$ref": "#/$defs/packStandards"
    },
    "deferred_standards": {
      "$ref": "#/$defs/packStandards"
    }
  },
  "$defs": {
    "packStandards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "role",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "role": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[0-9]{3}\\.CHECK-[0-9]{3}$"
            }
          }
        }
      }
    }
  }
}
